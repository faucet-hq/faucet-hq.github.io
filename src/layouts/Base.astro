---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'faucet-stream — move data at Rust speed',
  description = 'A fast, config-driven data-movement platform for Rust. 66 source & sink connectors, governance in flight, shipped as a single binary. 712k rows/s on a 1M-row move — ~96× faster than Meltano.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

// Privacy-friendly, cookieless analytics (Cloudflare Web Analytics).
// Set the token via the CF_WEB_ANALYTICS_TOKEN build env to activate; empty = off
// (no script, no cookies). Get a token at Cloudflare → Web Analytics (free).
const cfAnalyticsToken = import.meta.env.CF_WEB_ANALYTICS_TOKEN || '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'faucet-stream',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  description,
  url: 'https://faucet-hq.github.io/',
  softwareHelp: 'https://faucet-hq.github.io/faucet-stream/',
  codeRepository: 'https://github.com/faucet-hq/faucet-stream',
  programmingLanguage: 'Rust',
  license: 'https://opensource.org/license/apache-2-0',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Apply the saved theme before paint so there's no flash (FOUC). -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light')
            document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14b8a6" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="faucet-stream" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    {cfAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script is:inline>
      // Scroll reveal — progressive enhancement, respects reduced motion.
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const items = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      })();

      // Theme toggle — flips between light/dark and persists the choice.
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        const current = () => {
          const attr = document.documentElement.getAttribute('data-theme');
          return attr || (mq.matches ? 'dark' : 'light');
        };
        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
        });
      })();

      // Copy-to-clipboard for install commands.
      (() => {
        document.addEventListener('click', (ev) => {
          const btn = ev.target.closest('[data-copy]');
          if (!btn) return;
          const text = btn.getAttribute('data-copy');
          navigator.clipboard?.writeText(text).then(() => {
            btn.classList.add('copied');
            const prev = btn.getAttribute('aria-label');
            btn.setAttribute('aria-label', 'Copied');
            setTimeout(() => {
              btn.classList.remove('copied');
              if (prev) btn.setAttribute('aria-label', prev);
            }, 1600);
          });
        });
      })();
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: 0.75rem;
        top: -3rem;
        z-index: 100;
        background: var(--ink);
        color: #fff;
        padding: 0.5rem 0.9rem;
        border-radius: 8px;
        font-size: 0.9rem;
        transition: top 0.16s ease;
      }
      .skip-link:focus {
        top: 0.75rem;
      }
    </style>
  </body>
</html>
