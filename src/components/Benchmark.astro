---
const BENCH = `${import.meta.env.BASE_URL}benchmarks`;
// Bar length tracks the raw value, so the "better" tool is visibly bigger for
// throughput (higher = better) and visibly *smaller* for memory (lower = better).
// A tiny floor keeps the losing/winning sliver visible.
const rows = [
  { tool: 'faucet-stream', val: '712,000', unit: 'rows/s', pct: 100, self: true },
  { tool: 'Meltano (Singer)', val: '7,400', unit: 'rows/s', pct: 4 },
];
const mem = [
  { tool: 'faucet-stream', val: '11.8', unit: 'MiB', pct: 3, self: true },
  { tool: 'Meltano (Singer)', val: '724', unit: 'MiB', pct: 100 },
];
---

<section class="bench section" id="benchmarks">
  <div class="wrap bench-grid">
    <div class="bench-copy" data-reveal>
      <span class="eyebrow eyebrow--dark">Benchmarks</span>
      <h2>The same million rows — <span class="hl">1.4&#8239;seconds</span>, not two&nbsp;minutes.</h2>
      <p>
        A reproducible 1M-row CSV → JSONL move: faucet-stream finishes in ~1.4s;
        Meltano takes ~2¼ minutes for the identical, row-for-row output. That's the
        best case (it maximally exposes Python's per-row overhead) — sink-bound moves
        like Postgres → Postgres narrow the gap, and every caveat is in the open.
      </p>
      <a class="btn btn--onDark" href={BENCH}>See the full benchmarks →</a>
    </div>

    <div class="bench-charts" data-reveal style="--reveal-delay:.1s">
      <div class="chart">
        <div class="chart-title">Throughput <span>higher is better</span></div>
        {rows.map((r) => (
          <div class={`row ${r.self ? 'row--self' : ''}`}>
            <span class="row-tool">{r.tool}</span>
            <div class="track">
              <span class="fill" style={`--w:${r.pct}%`}></span>
            </div>
            <span class="row-val">{r.val} <i>{r.unit}</i></span>
          </div>
        ))}
      </div>

      <div class="chart">
        <div class="chart-title">Peak memory <span>lower is better</span></div>
        {mem.map((r) => (
          <div class={`row ${r.self ? 'row--self' : ''}`}>
            <span class="row-tool">{r.tool}</span>
            <div class="track">
              <span class="fill" style={`--w:${r.pct}%`}></span>
            </div>
            <span class="row-val">{r.val} <i>{r.unit}</i></span>
          </div>
        ))}
      </div>

      <p class="bench-foot">
        ~96× faster · ~62× less memory · exact row parity · single binary, no daemon
      </p>
    </div>
  </div>
</section>

<style>
  .bench {
    background:
      radial-gradient(70% 90% at 85% 0%, var(--night-2), transparent 60%),
      var(--night);
    color: var(--night-ink);
  }
  .bench-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .eyebrow--dark { color: var(--teal); }
  .bench h2 {
    color: #fff;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    margin-top: 1rem;
  }
  .bench h2 .hl { color: var(--teal); }
  .bench-copy p {
    margin-top: 1rem;
    color: var(--night-soft);
    font-size: 1.05rem;
    max-width: 34rem;
  }
  .btn--onDark {
    margin-top: 1.7rem;
    background: var(--teal);
    color: #04140f;
    font-weight: 600;
  }
  .btn--onDark:hover { background: #2fd4c1; }

  .bench-charts {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--night-line);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 3vw, 2rem);
  }
  .chart + .chart { margin-top: 1.8rem; }
  .chart-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--night-ink);
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.9rem;
  }
  .chart-title span {
    color: var(--night-soft);
    text-transform: none;
    letter-spacing: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 8.5rem 1fr auto;
    align-items: center;
    gap: 0.8rem;
    padding-block: 0.5rem;
  }
  .row-tool {
    font-size: 0.86rem;
    color: var(--night-soft);
  }
  .row--self .row-tool { color: #fff; font-weight: 600; }
  .track {
    position: relative;
    height: 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #1f6b60, #3a8c7e);
    transition: width 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .row--self .fill {
    background: linear-gradient(90deg, var(--teal-deep), var(--teal));
    box-shadow: 0 0 18px rgba(20, 184, 166, 0.5);
  }
  [data-reveal].is-in .fill { width: var(--w); }

  .row-val {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: #fff;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .row-val i { color: var(--night-soft); font-style: normal; font-size: 0.8rem; }

  .bench-foot {
    margin-top: 1.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--night-line);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--night-soft);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .fill { transition: none; }
  }
  @media (max-width: 860px) {
    .bench-grid { grid-template-columns: 1fr; }
  }
  /* Mobile: tool + value on the top line, a full-width bar below — so both
     rows' bars are identical regardless of the number's text width. */
  @media (max-width: 600px) {
    .row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "tool val"
        "bar  bar";
      gap: 0.3rem 0.6rem;
      align-items: baseline;
    }
    .row-tool { grid-area: tool; }
    .row-val { grid-area: val; justify-self: end; }
    .track { grid-area: bar; margin-top: 0.15rem; }
  }
</style>
