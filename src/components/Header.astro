---
import AskAI from './AskAI.astro';
const GITHUB = 'https://github.com/faucet-hq/faucet-stream';
const DOCS = 'https://faucet-hq.github.io/faucet-stream/';
const base = import.meta.env.BASE_URL; // "/" or "/dev/"
const nav = [
  { label: 'Why', href: `${base}#why` },
  { label: 'Benchmarks', href: `${base}benchmarks` },
  { label: 'Connectors', href: `${base}connectors` },
  { label: 'Governance', href: `${base}governance` },
  { label: 'Observability', href: `${base}observability` },
  { label: 'Compare', href: `${base}compare` },
  { label: 'Papers', href: `${base}papers` },
  { label: 'Blog', href: `${base}blog` },
  { label: 'Docs', href: DOCS },
];
---

<header class="site-header">
  <div class="wrap bar">
    <button class="nav-toggle" id="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="primary-nav">
      <svg class="i-bars" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="i-x" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <a class="brand" href={base} aria-label="faucet-stream home">
      <svg class="brand-mark" viewBox="6 11 112 112" width="26" height="26" aria-hidden="true">
        <g fill="none" stroke="#14B8A6" stroke-width="13" stroke-linecap="round" stroke-linejoin="round">
          <path d="M55 40 V24" /><path d="M43 24 H67" />
          <path d="M32 40 H78 a15 15 0 0 1 15 15 V66" />
        </g>
        <g fill="#14B8A6">
          <circle cx="93" cy="82" r="6" />
          <circle cx="93" cy="99" r="5" opacity="0.7" />
          <circle cx="93" cy="112" r="4" opacity="0.45" />
        </g>
      </svg>
      <span class="brand-word"><strong>faucet</strong>stream</span>
    </a>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      {nav.map((n) => <a href={n.href} target={n.href.startsWith('http') ? '_blank' : undefined} rel={n.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{n.label}</a>)}
    </nav>

    <div class="header-actions">
      <AskAI />
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
      <a class="gh" href={GITHUB} target="_blank" rel="noopener noreferrer" aria-label="faucet-stream on GitHub">
        <svg viewBox="0 0 16 16" width="19" height="19" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>
      <a class="btn install-cta" href={DOCS} target="_blank" rel="noopener noreferrer">Get started</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.16rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .brand-word strong { font-weight: 700; }
  .brand-word { font-weight: 400; color: var(--teal-deep); }
  .brand-word strong { color: var(--ink); }

  .nav {
    display: flex;
    gap: 1.6rem;
    margin-inline: auto;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .nav a {
    position: relative;
    padding-block: 0.2rem;
    transition: color 0.16s ease;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.15rem;
    width: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--teal);
    transition: width 0.2s ease;
  }
  .nav a:hover { color: var(--ink); }
  .nav a:hover::after { width: 100%; }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .gh {
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 9px;
    color: var(--ink-soft);
    transition: color 0.16s ease, background 0.16s ease;
  }
  .gh:hover { color: var(--ink); background: var(--surface-2); }
  .install-cta { padding-block: 0.55rem; }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 9px;
    border: 0;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition: color 0.16s ease, background 0.16s ease;
  }
  .theme-toggle:hover { color: var(--ink); background: var(--surface-2); }
  /* show sun in dark (click → light), moon in light (click → dark) */
  .theme-toggle .i-sun { display: none; }
  .theme-toggle .i-moon { display: block; }
  :root[data-theme='dark'] .theme-toggle .i-sun { display: block; }
  :root[data-theme='dark'] .theme-toggle .i-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .i-sun { display: block; }
    :root:not([data-theme='light']) .theme-toggle .i-moon { display: none; }
  }

  /* Hamburger — hidden on desktop, shown on mobile */
  .nav-toggle {
    display: none;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 9px;
    border: 0;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition: color 0.16s ease, background 0.16s ease;
  }
  .nav-toggle:hover { color: var(--ink); background: var(--surface-2); }
  .nav-toggle .i-x { display: none; }
  .nav-toggle[aria-expanded='true'] .i-bars { display: none; }
  .nav-toggle[aria-expanded='true'] .i-x { display: block; }

  @media (max-width: 860px) {
    .nav-toggle { display: inline-grid; }
    /* hamburger sits far left, brand beside it, actions pinned right */
    .brand { margin-inline-end: auto; }
    /* nav becomes a dropdown panel under the sticky bar */
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin-inline: 0;
      flex-direction: column;
      gap: 0;
      display: none;
      padding: 0.4rem var(--gutter) 1rem;
      background: color-mix(in srgb, var(--paper) 97%, transparent);
      backdrop-filter: saturate(1.4) blur(12px);
      -webkit-backdrop-filter: saturate(1.4) blur(12px);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-md);
    }
    .nav.open { display: flex; }
    .nav a {
      padding: 0.85rem 0.2rem;
      font-size: 1.05rem;
      color: var(--ink);
      border-bottom: 1px solid var(--line-soft);
    }
    .nav a:last-child { border-bottom: 0; }
    .nav a::after { display: none; }
  }
  @media (max-width: 480px) {
    .install-cta { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-toggle, .theme-toggle, .gh { transition: none; }
  }
</style>

<script>
  // Mobile hamburger: toggle the nav dropdown; close on link-click, Escape,
  // or a click outside. No-op if the elements are absent.
  const btn = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');
  if (btn && nav) {
    const close = () => {
      nav.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Open menu');
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('click', (e) => {
      if (!nav.contains(e.target) && !btn.contains(e.target)) close();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }
</script>
