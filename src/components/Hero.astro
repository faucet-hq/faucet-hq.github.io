---
import PipelineFlow from './PipelineFlow.astro';
const DOCS = 'https://faucet-hq.github.io/faucet-stream/';
const GITHUB = 'https://github.com/faucet-hq/faucet-stream';
const DEPLOY_DOCS = 'https://faucet-hq.github.io/faucet-stream/operations/deploying.html';

const installs = [
  { id: 'brew', label: 'Homebrew', cmd: 'brew install faucet-hq/faucet-stream/faucet-cli' },
  { id: 'cargo', label: 'Cargo', cmd: 'cargo install faucet-cli' },
  { id: 'docker', label: 'Docker', cmd: 'docker run --rm -v "$PWD:/w" ghcr.io/faucet-hq/faucet-stream:full run /w/pipeline.yaml' },
];
---

<section class="hero" id="main">
  <div class="hero-grid wrap">
    <div class="hero-copy">
      <span class="eyebrow" data-reveal>Rust data-movement platform</span>

      <h1 data-reveal style="--reveal-delay:.05s">
        Move data at <span class="accent">Rust speed</span>.<br />
        Govern it in flight.
      </h1>

      <p class="lede" data-reveal style="--reveal-delay:.1s">
        A config-driven pipeline engine with <b>66 source &amp; sink connectors</b>,
        change-data-capture, effectively-once delivery, and governance built into the
        movement path — wired by a single <code>faucet</code> binary, or embedded in your
        own service. No Python runtime, no platform to stand up.
      </p>

      <div class="install-tabs" data-reveal style="--reveal-delay:.15s">
        {installs.map((it, i) => (
          <input type="radio" name="inst" id={`inst-${it.id}`} checked={i === 0} />
        ))}
        <div class="install-labels" role="tablist" aria-label="Install method">
          {installs.map((it) => (
            <label for={`inst-${it.id}`} role="tab">{it.label}</label>
          ))}
        </div>
        {installs.map((it) => (
          <div class={`install pane-${it.id}`}>
            <span class="prompt" aria-hidden="true">$</span>
            <code>{it.cmd}</code>
            <button class="copy" data-copy={it.cmd} aria-label={`Copy ${it.label} command`} title="Copy">
              <svg class="i-copy" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M5 15V5a2 2 0 0 1 2-2h10" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
              <svg class="i-check" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m5 13 4 4L19 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        ))}
      </div>
      <p class="install-alt" data-reveal style="--reveal-delay:.18s">
        or embed the library — <code>cargo add faucet-stream</code> ·
        <a href={DEPLOY_DOCS}>deploy with Docker or Helm&nbsp;→</a>
      </p>

      <div class="hero-cta" data-reveal style="--reveal-delay:.22s">
        <a class="btn" href={DOCS}>Read the guide →</a>
        <a class="btn btn--ghost" href={GITHUB}>Star on GitHub</a>
      </div>
    </div>

    <div class="hero-visual" data-reveal style="--reveal-delay:.12s">
      <PipelineFlow />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
  }
  /* ambient flow field behind the hero */
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 120%;
    background:
      radial-gradient(60% 50% at 78% 20%, rgba(20, 184, 166, 0.1), transparent 70%),
      radial-gradient(50% 40% at 15% 5%, rgba(20, 184, 166, 0.06), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.15rem);
    font-weight: 680;
    margin-top: 1.15rem;
  }
  h1 .accent { color: var(--teal-deep); }

  .lede {
    margin-top: 1.4rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--ink-soft);
    max-width: 34rem;
  }
  .lede b { color: var(--ink); font-weight: 600; }
  .lede code {
    font-size: 0.92em;
    background: var(--surface-2);
    padding: 0.05em 0.35em;
    border-radius: 5px;
  }

  /* install method tabs (CSS-only) */
  .install-tabs {
    margin-top: 1.9rem;
    max-width: 34rem;
  }
  .install-tabs > input { position: absolute; opacity: 0; pointer-events: none; }
  .install-labels { display: flex; gap: 0.35rem; margin-bottom: 0.55rem; }
  .install-labels label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    padding: 0.28rem 0.7rem;
    border-radius: 7px;
    border: 1px solid var(--line);
    background: var(--surface);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .install-labels label:hover { color: var(--ink); border-color: var(--teal); }
  .install-labels label:focus-visible { outline: 2px solid var(--teal-deep); outline-offset: 2px; }
  #inst-brew:checked ~ .install-labels label[for='inst-brew'],
  #inst-cargo:checked ~ .install-labels label[for='inst-cargo'],
  #inst-docker:checked ~ .install-labels label[for='inst-docker'] {
    color: #fff;
    background: var(--teal-deep);
    border-color: var(--teal-deep);
  }

  .install {
    display: none;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.7rem 0.7rem 1rem;
    background: var(--term-bg);
    border-radius: 11px;
    box-shadow: var(--shadow-md);
    width: 100%;
    max-width: 34rem;
    overflow: hidden;
  }
  #inst-brew:checked ~ .pane-brew,
  #inst-cargo:checked ~ .pane-cargo,
  #inst-docker:checked ~ .pane-docker { display: flex; }
  .install .prompt { color: var(--teal); font-family: var(--font-mono); font-weight: 600; }
  .install code {
    color: #eef6f4;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow-x: auto;
    flex: 1;
    min-width: 0; /* allow the flex child to shrink so it scrolls instead of forcing page width */
    scrollbar-width: none;
  }
  .install code::-webkit-scrollbar { display: none; }
  .copy {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
    border: 0;
    background: rgba(255, 255, 255, 0.08);
    color: #cfe9e3;
    cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease;
  }
  .copy:hover { background: rgba(20, 184, 166, 0.25); color: #fff; }
  .copy .i-check { display: none; }
  .copy.copied { color: var(--teal); }
  .copy.copied .i-copy { display: none; }
  .copy.copied .i-check { display: block; }

  .install-alt {
    margin-top: 0.85rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .install-alt code {
    font-family: var(--font-mono);
    color: var(--ink-soft);
  }
  .install-alt a {
    color: var(--teal-deep);
    font-weight: 550;
    border-bottom: 1px solid color-mix(in srgb, var(--teal-deep) 35%, transparent);
    transition: border-color 0.15s ease;
  }
  .install-alt a:hover { border-color: var(--teal-deep); }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  /* both grid children must be allowed to shrink below their min-content,
     or the nowrap install command forces the track wider than the viewport. */
  .hero-copy,
  .hero-visual { min-width: 0; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    /* hard viewport cap so the card can never exceed the phone width,
       independent of how the grid track resolves its content size */
    .hero-visual {
      order: -1;
      justify-self: stretch;
      max-width: calc(100vw - 2 * var(--gutter));
    }
  }
  @media (max-width: 480px) {
    .install-labels { flex-wrap: wrap; }
  }
</style>
