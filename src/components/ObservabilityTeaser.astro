---
const OBS = `${import.meta.env.BASE_URL}observability`;
const pills = ['Prometheus metrics', 'OTLP tracing spans', '120+ metrics', 'zero per-connector code'];
---

<section class="section obs-teaser">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Observability</span>
      <h2>Metrics and traces, built in.</h2>
      <p>
        Every source, sink, transform, and state op emits Prometheus metrics and
        OpenTelemetry spans automatically — labelled by pipeline, row, and connector.
        Scrape <code>/metrics</code>, ship spans over OTLP, point Grafana at it.
      </p>
    </div>

    <div class="obs-pills" data-reveal style="--reveal-delay:.08s">
      {pills.map((p) => <span>{p}</span>)}
    </div>

    <div class="obs-cta" data-reveal style="--reveal-delay:.12s">
      <a class="btn btn--ghost" href={OBS}>Explore observability →</a>
    </div>
  </div>
</section>

<style>
  .obs-teaser { background: var(--surface-2); border-block: 1px solid var(--line); }
  .obs-teaser p code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    padding: 0.05em 0.32em;
    border-radius: 4px;
  }
  .obs-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }
  .obs-pills span {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--teal-deep);
    background: var(--teal-wash);
    border: 1px solid color-mix(in srgb, var(--teal) 22%, transparent);
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
  }
  .obs-cta { margin-top: 1.8rem; }
</style>
