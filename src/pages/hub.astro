---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';

const base = import.meta.env.BASE_URL;
const HUB_REPO = 'https://github.com/faucet-hq/template-hub';
const INDEX_URL = 'https://raw.githubusercontent.com/faucet-hq/template-hub/main/index.json';
const INDEX_FALLBACK = 'https://cdn.jsdelivr.net/gh/faucet-hq/template-hub@main/index.json';
const DOCS = 'https://faucet-hq.github.io/faucet-stream/cookbook/template-hub.html';
const CONTRIBUTING = `${HUB_REPO}/blob/main/CONTRIBUTING.md`;

// "Publish" opens GitHub's new-file form pre-filled with a skeleton; for a
// non-collaborator GitHub forks the repo and opens a pull request — which is
// exactly how a template is registered in the hub.
const SOURCE_SKELETON = `kind: source-template
name: my-system                      # == the file name; lowercase, digits, - _
owner: your-github-login             # == the directory this file lives in (your GitHub user or org)
description: My System — what it exports, in one line
tags: [category]
docs: https://developer.example.com/api
params:
  api_token: { type: string, required: true, secret: true, description: "API token" }
source:
  type: rest
  config:
    base_url: https://api.example.com/v1
    auth: { type: bearer, config: { token: "\${param.api_token}" } }
    records_path: $.data[*]
    pagination: { type: NextLinkInBody, next_link_path: $.next }
transforms:
  - { type: keys_case, config: { mode: snake } }
streams:
  - name: customers
    source: { config: { path: /customers } }
    primary_keys: [id]
    write: [overwrite, upsert]
  - name: events
    source: { config: { path: /events, replication_method: { type: Incremental, replication_key: updated_at } } }
    primary_keys: [id]
    write: [upsert, append]
`;
const SINK_SKELETON = `kind: sink-template
name: my-destination                 # == the file name
owner: your-github-login             # == the directory this file lives in
description: My Destination — one table per stream
params:
  dsn: { type: string, required: true, secret: true, description: "Connection string" }
sink:
  type: postgres
  config:
    connection_url: "\${param.dsn}"
    auto_map: true
per_stream:
  table: "\${stream}"
`;
const newFile = (dir: string, name: string, body: string) =>
  `${HUB_REPO}/new/main/${dir}?filename=${encodeURIComponent(name)}&value=${encodeURIComponent(body)}`;
// The namespace directory is the publisher's GitHub login; a static page cannot
// know it, so the filename carries the placeholder and CI corrects a wrong one.
const PUBLISH_SOURCE = newFile('source-templates', 'your-github-login/my-system.yaml', SOURCE_SKELETON);
const PUBLISH_SINK = newFile('sink-templates', 'your-github-login/my-destination.yaml', SINK_SKELETON);

const SYNC_YAML = `version: 1
origins:
  - name: hub
    source:
      type: github
      config: { repo: faucet-hq/template-hub, paths: [source-templates, sink-templates] }
    launch: always
    interval_secs: 3600`;
---

<Base
  title="Template Hub — faucet-stream"
  description="Pick a source template, pick a destination, run. The shared catalog of faucet-stream source × sink templates — browse every pairing, copy the command, publish your own with a pull request."
>
  <Header />
  <main id="main" class="hub-page">
    <section class="section head">
      <div class="wrap">
        <span class="eyebrow" data-reveal>Template Hub</span>
        <h1 data-reveal style="--reveal-delay:.05s">Pick a source. Pick a destination. Run.</h1>
        <p class="lede" data-reveal style="--reveal-delay:.1s">
          A <strong>source template</strong> describes one system once — auth, pagination,
          incremental cursors, and the streams it produces. A <strong>sink template</strong>
          describes where rows land. Any source composes with any sink at run time, so a
          template written for one warehouse works for every other destination here.
        </p>
        <div class="stats" id="hub-stats" data-reveal style="--reveal-delay:.14s" aria-live="polite">
          <a class="stat" href="#sources"><b id="n-sources">…</b> sources</a>
          <a class="stat" href="#sinks"><b id="n-sinks">…</b> sinks</a>
          <a class="stat" href="#matrix"><b id="n-pairs">…</b> compatible pairings</a>
          <span class="stat"><b id="n-official">…</b> official</span>
          <span class="stat stat-meta" id="hub-meta"></span>
        </div>
        <div class="actions" data-reveal style="--reveal-delay:.18s">
          <a class="btn" href="#publish">Publish a template</a>
          <a class="btn btn--ghost" href={HUB_REPO} target="_blank" rel="noopener noreferrer">Catalog on GitHub →</a>
        </div>
      </div>
    </section>

    <section class="section band compose" id="compose">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Try a pairing</span>
          <h2>Pick any two. Get the command.</h2>
          <p>Choose a source and a sink to see how each stream will be written, and copy the command that runs it.</p>
        </div>
        <div class="compose-card">
          <div class="compose-row">
            <label>source
              <select id="c-source" aria-label="Source template"></select>
            </label>
            <span class="times" aria-hidden="true">×</span>
            <label>sink
              <select id="c-sink" aria-label="Sink template"></select>
            </label>
          </div>
          <div id="c-plan" class="plan" aria-live="polite"></div>
          <div class="cmd" id="c-cmd-wrap" hidden>
            <pre><code id="c-cmd"></code></pre>
            <button class="copy" id="c-copy" type="button" aria-label="Copy command" title="Copy">copy</button>
          </div>
          <p class="hint">
            Runs against the public hub with no checkout — the CLI caches the catalog under
            <code>~/.cache/faucet/hub</code>. Install with
            <code>curl -LsSf https://github.com/faucet-hq/faucet-stream/releases/latest/download/faucet-cli-installer.sh | sh</code>.
          </p>
        </div>
      </div>
    </section>

    <section class="section catalog" id="sources">
      <div class="wrap">
        <div class="catalog-head">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Catalog</span>
            <h2>Source templates</h2>
            <p>One file per system: auth, pagination, incremental cursors and the streams it produces. Written once, it runs on every sink below.</p>
          </div>
          <div class="catalog-tools">
            <input id="q" type="search" placeholder="filter by name, tag, or system…" autocomplete="off" aria-label="Filter source and sink templates" />
            <label class="sort">Sort
              <select id="sort" aria-label="Sort templates">
                <option value="rank">Recommended</option>
                <option value="stars">Most starred</option>
                <option value="updated">Recently updated</option>
                <option value="name">Name</option>
              </select>
            </label>
          </div>
        </div>
        <div class="grid" id="source-grid" aria-busy="true">
          <div class="empty" id="loading">Loading the catalog…</div>
        </div>
      </div>
    </section>

    <section class="section band catalog" id="sinks">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Destinations</span>
          <h2>Sink templates</h2>
          <p>Where rows land. Each sink lists the write modes it supports natively; a source asks for a mode per stream.</p>
        </div>
        <div class="grid" id="sink-grid"></div>
      </div>
    </section>

    <section class="section catalog" id="matrix">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Compatibility</span>
          <h2>Which source runs on which sink</h2>
          <p>✓ every stream has a write mode the sink supports · <i>n/m</i> only some streams do. Click a cell to load its command in <a href="#compose">Try a pairing</a>.</p>
        </div>
        <div class="matrix-scroll"><table class="matrix" id="matrix-table"></table></div>
      </div>
    </section>

    <section class="section band publish" id="publish">
      <div class="wrap">
      <div class="section-head publish-head" data-reveal>
      <span class="eyebrow">Publish</span>
      <h2>Registering a template is a pull request.</h2>
      <p>
        The catalog is a public repository. Open a pre-filled file under <strong>your own
        namespace</strong> — <code>source-templates/&lt;your-github-login&gt;/</code> — describe
        your system, and CI lints it, composes it against every sink, and regenerates the index
        on merge. The namespace is yours: only the GitHub user or org that owns it can change it,
        and a hundred people can publish their own <code>netsuite</code> without colliding
        (<code>acme/netsuite</code>, <code>octo/netsuite</code>, …). The hub's own templates live
        in <code>faucet-hq/</code>, owned by the org the same way. Every merged change becomes
        the next version — v1, v2, v3 — and a sidecar decides which one is <em>stable</em>. No
        credentials ever go in: every secret is a <code>$&#123;param.NAME&#125;</code> the
        person running it supplies.
      </p>
      </div>
      <div class="publish-grid">
        <div class="pub-card">
          <h3>1 · Open a skeleton</h3>
          <p>Rename the <code>your-github-login</code> folder to your GitHub user or org. GitHub forks the catalog for you and opens a pull request when you save; the first PR into a namespace also adds its <code>OWNERS</code> file.</p>
          <div class="actions">
            <a class="btn" href={PUBLISH_SOURCE} target="_blank" rel="noopener noreferrer">New source template →</a>
            <a class="btn btn--ghost" href={PUBLISH_SINK} target="_blank" rel="noopener noreferrer">New sink template →</a>
          </div>
        </div>
        <div class="pub-card">
          <h3>2 · Check it locally</h3>
          <pre><code>faucet hub lint  --hub .
faucet hub check --hub . --source my-system --sink jsonl
faucet hub check --hub . --source my-system --sink bigquery</code></pre>
          <p>Every source must compose with at least two sinks. See <a href={CONTRIBUTING}>CONTRIBUTING</a> for the rules the lint enforces.</p>
        </div>
        <div class="pub-card">
          <h3>3 · Or keep it private</h3>
          <p>Your organisation's templates can live in any repository with the same layout:</p>
          <pre><code>faucet run --hub github:acme/catalog --source acme-erp --sink snowflake …</code></pre>
          <p>Set <code>GITHUB_TOKEN</code> for a private repo.</p>
        </div>
      </div>

      <h3 class="mirror-h">Mirror the hub into your own server</h3>
      <p>
        <code>faucet serve</code> pulls the catalog into its template registry. The web console
        then lists every template, offers each registered sink on a source's trigger form, and
        shows this same matrix from your registry.
      </p>
      <pre><code>{SYNC_YAML}</code></pre>
      <pre><code>faucet serve --history sqlite:./faucet.db --templates-sync hub-sync.yaml</code></pre>
      <p class="docs-link">Full reference: <a href={DOCS}>Template Hub cookbook</a>.</p>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</Base>

<script is:inline define:vars={{ INDEX_URL, INDEX_FALLBACK, HUB_REPO }}>
  (async () => {
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

    async function load() {
      for (const url of [INDEX_URL, INDEX_FALLBACK]) {
        try {
          const r = await fetch(url, { cache: 'no-cache' });
          if (r.ok) return await r.json();
        } catch (e) { /* try the next */ }
      }
      throw new Error('catalog unreachable');
    }

    let idx;
    try {
      idx = await load();
    } catch (e) {
      $('loading').textContent = 'The catalog could not be loaded right now — browse it on GitHub: ' + HUB_REPO;
      $('source-grid').setAttribute('aria-busy', 'false');
      return;
    }
    const sources = idx.sources || [];
    const sinks = idx.sinks || [];
    const cells = new Map((idx.matrix || []).map((c) => [c.source + '\u0000' + c.sink, c]));
    const grouped = (list) => {
      const byName = new Map();
      for (const t of list) { const k = t.name; if (!byName.has(k)) byName.set(k, []); byName.get(k).push(t); }
      return byName;
    };
    const cell = (s, k) => cells.get(s + '\u0000' + k);

    // ── stats ────────────────────────────────────────────────────────────
    $('n-sources').textContent = sources.length;
    $('n-sinks').textContent = sinks.length;
    $('n-pairs').textContent = (idx.matrix || []).filter((c) => c.compatible).length;
    const OFFICIAL_OWNER = 'faucet-hq';
    const isOfficial = (t) => t.owner === OFFICIAL_OWNER || t.official === true;
    $('n-official').textContent = sources.filter(isOfficial).length;
    const idOf = (t) => t.id || t.name;
    const titleOf = (t) => (t.owner ? `<span class="ns">${esc(t.owner)}/</span>${esc(t.name)}` : esc(t.name));
    const verOf = (t) => (t.newest ? ` <span class="ver" title="${t.versions ? esc(t.versions.map((v) => 'v' + v.version + ' · ' + (v.date || '').slice(0, 10)).join('\n')) : ''}">v${t.newest}${t.stable && t.stable !== t.newest ? ` · stable v${t.stable}` : ''}</span>` : '');
    const ownerBadge = (t) => (isOfficial(t)
      ? `<a class="official" href="https://github.com/${OFFICIAL_OWNER}" target="_blank" rel="noopener noreferrer" title="maintained by the faucet-hq org">official · @${OFFICIAL_OWNER}</a>`
      : t.owner
        ? `<a class="owner" href="https://github.com/${esc(t.owner)}" target="_blank" rel="noopener noreferrer" title="published by ${esc(t.owner)}">@${esc(t.owner)}</a>`
        : `<span class="owner" title="unscoped template">unscoped</span>`);
    $('hub-meta').textContent = 'live from faucet-hq/template-hub';

    // ── trust signals (#685) ───────────────────────────────────────────
    const trustOf = (t) => t.trust || {};
    const starsOf = (t) => trustOf(t).stars || 0;
    const updatedOf = (t) => trustOf(t).updated || '';
    const byId = (a, b) => idOf(a).localeCompare(idOf(b));
    // Recommended: official first, then stars, then freshness — same order as `faucet hub list`.
    const SORTS = {
      rank: (a, b) => (isOfficial(b) - isOfficial(a)) || (starsOf(b) - starsOf(a)) || updatedOf(b).localeCompare(updatedOf(a)) || byId(a, b),
      stars: (a, b) => (starsOf(b) - starsOf(a)) || SORTS.rank(a, b),
      updated: (a, b) => updatedOf(b).localeCompare(updatedOf(a)) || byId(a, b),
      name: byId,
    };
    const trustLine = (t) => {
      const tr = trustOf(t);
      const bits = [];
      if (tr.star_url) {
        bits.push(`<a class="star" href="${esc(tr.star_url)}" target="_blank" rel="noopener noreferrer" title="👍 the discussion to star it — accounts under 30 days old and the template's own publishers don't count">★ ${starsOf(t)} <span>· star on GitHub</span></a>`);
      } else if (tr.stars != null) {
        bits.push(`<span class="star">★ ${starsOf(t)}</span>`);
      }
      if (tr.updated) bits.push(`<span class="fact">updated ${esc(tr.updated)}</span>`);
      if (tr.stable_since && tr.stable_since !== tr.updated) bits.push(`<span class="fact">stable since ${esc(tr.stable_since)}</span>`);
      if (tr.open_issues) {
        const q = encodeURIComponent(`is:issue is:open label:"template:${idOf(t)}"`);
        bits.push(`<a class="fact issues" href="${HUB_REPO}/issues?q=${q}" target="_blank" rel="noopener noreferrer">${tr.open_issues} open issue${tr.open_issues === 1 ? '' : 's'}</a>`);
      }
      return bits.length ? `<div class="trust">${bits.join('')}</div>` : '';
    };

    // ── compose widget ──────────────────────────────────────────────────
    const cs = $('c-source'), ck = $('c-sink');
    cs.innerHTML = sources.map((s) => `<option value="${esc(idOf(s))}">${esc(idOf(s))}${isOfficial(s) ? ' (official)' : ''}</option>`).join('');
    ck.innerHTML = sinks.map((k) => `<option value="${esc(idOf(k))}">${esc(idOf(k))}${isOfficial(k) ? ' (official)' : ''}</option>`).join('');
    function renderPlan() {
      const c = cell(cs.value, ck.value);
      const plan = $('c-plan'), wrap = $('c-cmd-wrap');
      if (!c) { plan.innerHTML = ''; wrap.hidden = true; return; }
      const rows = (c.streams || []).map((p) =>
        `<li class="ok"><span class="mono">${esc(p.stream)}</span><span class="mode">${esc(p.write_mode)}${p.satisfies ? ` <em>for ${esc(p.satisfies)}</em>` : ''}</span></li>`)
        .concat((c.incompatible || []).map((i) => `<li class="bad"><span class="mono">${esc(i.stream)}</span><span class="mode">✗ ${esc(i.reason)}</span></li>`));
      plan.innerHTML = `<div class="plan-head ${c.compatible ? 'is-ok' : 'is-bad'}">${c.compatible ? '✓ compatible' : `✗ ${(c.incompatible || []).length} stream(s) have no viable write mode`}</div><ul>${rows.join('')}</ul>`;
      if (c.compatible && c.command) { $('c-cmd').textContent = c.command; wrap.hidden = false; } else { wrap.hidden = true; }
    }
    cs.onchange = ck.onchange = renderPlan;
    $('c-copy').onclick = async () => {
      try { await navigator.clipboard.writeText($('c-cmd').textContent); $('c-copy').textContent = 'copied'; setTimeout(() => ($('c-copy').textContent = 'copy'), 1200); } catch (e) { /* clipboard blocked */ }
    };
    renderPlan();

    // ── cards ───────────────────────────────────────────────────────────
    const paramList = (ps) => (ps || []).map((p) =>
      `<li><span class="mono">${esc(p.name)}</span> <span class="ptype">${esc(p.type || 'string')}${p.required ? ' · required' : ''}${p.secret ? ' · secret' : ''}</span>${p.description ? `<span class="pdesc">${esc(p.description)}</span>` : ''}</li>`).join('');
    const sourceCard = (s) => {
      const compat = sinks.filter((k) => cell(idOf(s), idOf(k))?.compatible).map((k) => idOf(k));
      const variants = (grouped(sources).get(s.name) || []).filter((o) => idOf(o) !== idOf(s)).sort(SORTS.rank);
      return `<article class="card" data-search="${esc([idOf(s), s.owner, s.description, s.source_type, ...(s.tags || [])].join(' ').toLowerCase())}">
        <header><h3 class="mono">${titleOf(s)}</h3><span class="badges">${ownerBadge(s)}${verOf(s)}<span class="kind">${esc(s.source_type || '')}</span></span></header>
        ${s.description ? `<p>${esc(s.description)}</p>` : ''}
        ${trustLine(s)}
        ${(s.tags || []).length ? `<div class="tags">${s.tags.map((t) => `<span class="tag">${esc(t)}</span>`).join('')}</div>` : ''}
        <details><summary>${(s.streams || []).length} stream${(s.streams || []).length === 1 ? '' : 's'} · ${(s.params || []).length} param${(s.params || []).length === 1 ? '' : 's'}</summary>
          <ul class="streams">${(s.streams || []).map((st) => `<li><span class="mono">${esc(st.name)}</span><span class="mode">${(st.write || []).join(' → ')}${(st.primary_keys || []).length ? ` · key ${esc(st.primary_keys.join(', '))}` : ''}</span></li>`).join('')}</ul>
          ${(s.params || []).length ? `<ul class="params">${paramList(s.params)}</ul>` : ''}
        </details>
        <footer><span class="compat">works with ${compat.length ? compat.map((n) => `<b>${esc(n)}</b>`).join(', ') : 'no sink yet'}</span>
          ${variants.length ? `<span class="compat">also for ${esc(s.name)}: ${variants.map((v) => `<b>${esc(idOf(v))}</b>${trustOf(v).stars != null ? ` ★ ${starsOf(v)}` : ''}`).join(', ')}</span>` : ''}
          <a href="${HUB_REPO}/blob/main/${esc(s.file || `source-templates/${s.name}.yaml`)}" target="_blank" rel="noopener noreferrer">source ↗</a>
          ${s.docs ? `<a href="${esc(s.docs)}" target="_blank" rel="noopener noreferrer">API docs ↗</a>` : ''}</footer>
      </article>`;
    };
    const sinkCard = (k) => `<article class="card" data-search="${esc([idOf(k), k.owner, k.description, k.sink_type, ...(k.tags || [])].join(' ').toLowerCase())}">
        <header><h3 class="mono">${titleOf(k)}</h3><span class="badges">${ownerBadge(k)}${verOf(k)}<span class="kind">${esc(k.sink_type || '')}</span></span></header>
        ${k.description ? `<p>${esc(k.description)}</p>` : ''}
        ${trustLine(k)}
        <div class="tags">${(k.write_modes || []).map((m) => `<span class="tag mode-tag">${esc(m)}</span>`).join('')}</div>
        ${(k.params || []).length ? `<details><summary>${k.params.length} param${k.params.length === 1 ? '' : 's'}</summary><ul class="params">${paramList(k.params)}</ul></details>` : ''}
        <footer><a href="${HUB_REPO}/blob/main/${esc(k.file || `sink-templates/${k.name}.yaml`)}" target="_blank" rel="noopener noreferrer">source ↗</a>
          ${k.docs ? `<a href="${esc(k.docs)}" target="_blank" rel="noopener noreferrer">docs ↗</a>` : ''}</footer>
      </article>`;
    const applyFilter = () => {
      const q = $('q').value.trim().toLowerCase();
      document.querySelectorAll('.hub-page .catalog .card').forEach((c) => { c.hidden = q && !c.dataset.search.includes(q); });
    };
    const renderGrids = () => {
      const cmp = SORTS[$('sort').value] || SORTS.rank;
      $('source-grid').innerHTML = sources.length ? [...sources].sort(cmp).map(sourceCard).join('') : '<div class="empty">No source templates yet — be the first to publish one.</div>';
      $('sink-grid').innerHTML = [...sinks].sort(cmp).map(sinkCard).join('');
      applyFilter();
    };
    const wanted = new URLSearchParams(location.search).get('sort');
    if (wanted && SORTS[wanted]) $('sort').value = wanted;
    renderGrids();
    $('source-grid').setAttribute('aria-busy', 'false');

    // ── filter + sort ───────────────────────────────────────────────────
    $('q').oninput = applyFilter;
    $('sort').onchange = () => {
      const u = new URL(location.href);
      if ($('sort').value === 'rank') u.searchParams.delete('sort'); else u.searchParams.set('sort', $('sort').value);
      history.replaceState(null, '', u);
      renderGrids();
    };

    // ── matrix ──────────────────────────────────────────────────────────
    const t = $('matrix-table');
    t.innerHTML = `<thead><tr><th class="corner">source \\ sink</th>${sinks.map((k) => `<th>${esc(idOf(k))}</th>`).join('')}</tr></thead>
      <tbody>${sources.map((s) => `<tr><th scope="row">${esc(idOf(s))}</th>${sinks.map((k) => {
        const c = cell(idOf(s), idOf(k)); if (!c) return '<td>—</td>';
        const n = (c.streams || []).length, m = (s.streams || []).length;
        const cls = c.compatible ? 'ok' : n ? 'partial' : 'bad';
        return `<td class="${cls}"><button type="button" data-s="${esc(idOf(s))}" data-k="${esc(idOf(k))}" title="${esc((c.streams || []).map((p) => `${p.stream}: ${p.write_mode}`).join('\n'))}">${c.compatible ? '✓' : n ? `${n}/${m}` : '✗'}</button></td>`;
      }).join('')}</tr>`).join('')}</tbody>`;
    t.addEventListener('click', (e) => {
      const b = e.target.closest('button[data-s]'); if (!b) return;
      cs.value = b.dataset.s; ck.value = b.dataset.k; renderPlan();
      document.getElementById('compose').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
