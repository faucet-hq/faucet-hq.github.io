---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import '../styles/hub.css';

const base = import.meta.env.BASE_URL;
const HUB_REPO = 'https://github.com/faucet-hq/template-hub';
const INDEX_URL = 'https://raw.githubusercontent.com/faucet-hq/template-hub/main/index.json';
const INDEX_FALLBACK = 'https://cdn.jsdelivr.net/gh/faucet-hq/template-hub@main/index.json';
const DOCS = 'https://faucet-hq.github.io/faucet-stream/cookbook/template-hub.html';
const CONTRIBUTING = `${HUB_REPO}/blob/main/CONTRIBUTING.md`;

// "Publish" opens GitHub's new-file form pre-filled with a skeleton; for a
// non-collaborator GitHub forks the repo and opens a pull request — which is
// exactly how a template is registered in the hub.
const SOURCE_SKELETON = `kind: source-template
name: my-system                      # == the file name; lowercase, digits, - _
owner: your-github-login             # == the directory this file lives in (your GitHub user or org)
description: My System — what it exports, in one line
tags: [category]
docs: https://developer.example.com/api
params:
  api_token: { type: string, required: true, secret: true, description: "API token" }
source:
  type: rest
  config:
    base_url: https://api.example.com/v1
    auth: { type: bearer, config: { token: "\${param.api_token}" } }
    records_path: $.data[*]
    pagination: { type: NextLinkInBody, next_link_path: $.next }
transforms:
  - { type: keys_case, config: { mode: snake } }
streams:
  - name: customers
    source: { config: { path: /customers } }
    primary_keys: [id]
    write: [overwrite, upsert]
  - name: events
    source: { config: { path: /events, replication_method: { type: Incremental, replication_key: updated_at } } }
    primary_keys: [id]
    write: [upsert, append]
`;
const SINK_SKELETON = `kind: sink-template
name: my-destination                 # == the file name
owner: your-github-login             # == the directory this file lives in
description: My Destination — one table per stream
params:
  dsn: { type: string, required: true, secret: true, description: "Connection string" }
sink:
  type: postgres
  config:
    connection_url: "\${param.dsn}"
    auto_map: true
per_stream:
  table: "\${stream}"
`;
const newFile = (dir: string, name: string, body: string) =>
  `${HUB_REPO}/new/main/${dir}?filename=${encodeURIComponent(name)}&value=${encodeURIComponent(body)}`;
// The namespace directory is the publisher's GitHub login; a static page cannot
// know it, so the filename carries the placeholder and CI corrects a wrong one.
const PUBLISH_SOURCE = newFile('source-templates', 'your-github-login/my-system.yaml', SOURCE_SKELETON);
const PUBLISH_SINK = newFile('sink-templates', 'your-github-login/my-destination.yaml', SINK_SKELETON);

const SYNC_YAML = `version: 1
origins:
  - name: hub
    source:
      type: github
      config: { repo: faucet-hq/template-hub, paths: [source-templates, sink-templates] }
    launch: always
    interval_secs: 3600`;
---

<Base
  title="Template Hub — faucet-stream"
  description="Pick a source template, pick a destination, run. The shared catalog of faucet-stream source × sink templates — browse every pairing, copy the command, publish your own with a pull request."
>
  <Header />
  <main id="main" class="hub-page">
    <section class="section head">
      <div class="wrap">
        <span class="eyebrow" data-reveal>Template Hub</span>
        <h1 data-reveal style="--reveal-delay:.05s">Pick a source. Pick a destination. Run.</h1>
        <p class="lede" data-reveal style="--reveal-delay:.1s">
          A <strong>source template</strong> describes one system once — auth, pagination,
          incremental cursors, and the streams it produces. A <strong>sink template</strong>
          describes where rows land. Any source composes with any sink at run time, so a
          template written for one warehouse works for every other destination here.
        </p>
        <div class="hub-stats" id="hub-stats" data-reveal style="--reveal-delay:.14s" aria-live="polite">
          <a class="hstat" href="#sources"><span class="hstat-n" id="n-sources">…</span><span class="hstat-l">source templates</span></a>
          <a class="hstat" href="#sinks"><span class="hstat-n" id="n-sinks">…</span><span class="hstat-l">sink templates</span></a>
          <a class="hstat" href="#compose"><span class="hstat-n" id="n-pairs">…</span><span class="hstat-l">compatible pairings</span></a>
          <a class="hstat" href="?owner=faucet-hq#sources" title="Show only the official templates"><span class="hstat-n" id="n-official">…</span><span class="hstat-l">official</span></a>
        </div>
        <p class="hub-live" data-reveal style="--reveal-delay:.16s"><span class="live-dot" aria-hidden="true"></span><span id="hub-meta"></span></p>
        <div class="actions" data-reveal style="--reveal-delay:.18s">
          <a class="btn" href="#publish">Publish a template</a>
          <a class="btn btn--ghost" href={HUB_REPO} target="_blank" rel="noopener noreferrer">Catalog on GitHub →</a>
        </div>
      </div>
    </section>

    <section class="section band compose" id="compose">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Try a pairing</span>
          <h2>Pick any two. Get the command.</h2>
          <p>Choose a source to see which sinks it runs on, pick one to see how each stream will be written, and copy the command that runs it.</p>
        </div>
        <div class="compose-card">
          <div id="pairing"></div>
          <p class="hint">
            Runs against the public hub with no checkout; the CLI caches the catalog under <code>~/.cache/faucet/hub</code>.
            <a href="https://faucet-hq.github.io/faucet-stream/getting-started/installation.html">Install the CLI →</a>
          </p>
        </div>
      </div>
    </section>

    <section class="section catalog" id="sources">
      <div class="wrap">
        <div class="catalog-head">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Catalog</span>
            <h2>Source templates</h2>
            <p>One file per system: auth, pagination, incremental cursors and the streams it produces. Written once, it runs on every sink below.</p>
          </div>
          <div class="catalog-tools">
            <input id="q-sources" class="filter" type="search" placeholder="filter by name, tag, or system…" autocomplete="off" aria-label="Filter source templates" />
            <div class="facets" id="facets-sources"></div>
            <select id="sort-sources" class="sort-select" aria-label="Sort source templates">
              <option value="rank">Sort: Recommended</option>
              <option value="stars">Sort: Most starred</option>
              <option value="updated">Sort: Recently updated</option>
              <option value="name">Sort: Name</option>
            </select>
          </div>
        </div>
        <div class="active-filters" id="active-sources" hidden></div>
        <div class="grid" id="source-grid" aria-busy="true">
          <div class="empty" id="loading">Loading the catalog…</div>
        </div>
        <div class="grid-more" id="more-sources" hidden><button type="button" class="btn btn--ghost"></button></div>
      </div>
    </section>

    <section class="section band catalog" id="sinks">
      <div class="wrap">
        <div class="catalog-head">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Destinations</span>
            <h2>Sink templates</h2>
            <p>Where rows land. Each sink lists the write modes it supports natively; a source asks for a mode per stream.</p>
          </div>
          <div class="catalog-tools">
            <input id="q-sinks" class="filter" type="search" placeholder="filter by name, tag, or system…" autocomplete="off" aria-label="Filter sink templates" />
            <div class="facets" id="facets-sinks"></div>
            <select id="sort-sinks" class="sort-select" aria-label="Sort sink templates">
              <option value="rank">Sort: Recommended</option>
              <option value="stars">Sort: Most starred</option>
              <option value="updated">Sort: Recently updated</option>
              <option value="name">Sort: Name</option>
            </select>
          </div>
        </div>
        <div class="active-filters" id="active-sinks" hidden></div>
        <div class="grid" id="sink-grid"></div>
        <div class="grid-more" id="more-sinks" hidden><button type="button" class="btn btn--ghost"></button></div>
      </div>
    </section>


    <section class="section band publish" id="publish">
      <div class="wrap">
      <div class="section-head publish-head" data-reveal>
      <span class="eyebrow">Publish</span>
      <h2>Registering a template is a pull request.</h2>
      <p>
        The catalog is a public repository. Open a pre-filled file under <strong>your own
        namespace</strong> — <code>source-templates/&lt;your-github-login&gt;/</code> — describe
        your system, and CI lints it, composes it against every sink, and regenerates the index
        on merge. The namespace is yours: only the GitHub user or org that owns it can change it,
        and a hundred people can publish their own <code>netsuite</code> without colliding
        (<code>acme/netsuite</code>, <code>octo/netsuite</code>, …). The hub's own templates live
        in <code>faucet-hq/</code>, owned by the org the same way. Every merged change becomes
        the next version — v1, v2, v3 — and a sidecar decides which one is <em>stable</em>. No
        credentials ever go in: every secret is a <code>$&#123;param.NAME&#125;</code> the
        person running it supplies.
      </p>
      </div>
      <div class="publish-grid">
        <div class="pub-card">
          <h3>1 · Open a skeleton</h3>
          <p>Rename the <code>your-github-login</code> folder to your GitHub user or org. GitHub forks the catalog for you and opens a pull request when you save; the first PR into a namespace also adds its <code>OWNERS</code> file.</p>
          <div class="actions pub-choices">
            <a class="btn pub-choice pub-choice--source" href={PUBLISH_SOURCE} target="_blank" rel="noopener noreferrer">New source template →</a>
            <a class="btn pub-choice pub-choice--sink" href={PUBLISH_SINK} target="_blank" rel="noopener noreferrer">New sink template →</a>
          </div>
        </div>
        <div class="pub-card">
          <h3>2 · Check it locally</h3>
          <pre><code>faucet hub lint  --hub .
faucet hub check --hub . --source your-github-login/my-system --sink faucet-hq/jsonl
faucet hub check --hub . --source your-github-login/my-system --sink faucet-hq/bigquery</code></pre>
          <p>Every source must compose with at least two sinks. See <a href={CONTRIBUTING}>CONTRIBUTING</a> for the rules the lint enforces.</p>
        </div>
        <div class="pub-card">
          <h3>3 · Or keep it private</h3>
          <p>Your organisation's templates can live in any repository with the same layout:</p>
          <pre><code>faucet run --hub github:acme/catalog --source acme/erp --sink acme/snowflake …</code></pre>
          <p>Set <code>GITHUB_TOKEN</code> for a private repo.</p>
        </div>
      </div>

      <h3 class="mirror-h">Mirror the hub into your own server</h3>
      <p>
        <code>faucet serve</code> pulls the catalog into its template registry. The web console
        then lists every template, offers each registered sink on a source's trigger form, and
        shows which sinks each registered source runs on.
      </p>
      <pre><code>{SYNC_YAML}</code></pre>
      <pre><code>faucet serve --history sqlite:./faucet.db --templates-sync hub-sync.yaml</code></pre>
      <p class="docs-link">Full reference: <a href={DOCS}>Template Hub cookbook</a>.</p>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</Base>

<script is:inline define:vars={{ HUB_BASE: base }}>window.HUB_BASE = HUB_BASE;</script>
<script is:inline src={`${base}hub-core.js`}></script>
<script is:inline>
  (async () => {
    const H = window.HubCore;
    const $ = (id) => document.getElementById(id);
    let cat;
    try {
      cat = await H.load();
    } catch (e) {
      $('loading').textContent = 'The catalog could not be loaded right now — browse it on GitHub: ' + H.HUB_REPO;
      $('source-grid').setAttribute('aria-busy', 'false');
      return;
    }
    const { sources, sinks } = cat;
    $('n-sources').textContent = sources.length;
    $('n-sinks').textContent = sinks.length;
    $('n-pairs').textContent = cat.compatiblePairs;
    $('n-official').textContent = sources.filter(H.isOfficial).length;
    $('hub-meta').textContent = 'Live from faucet-hq/template-hub';

    // ── try a pairing ────────────────────────────────────────────────────
    const params = new URLSearchParams(location.search);
    H.pairing($('pairing'), cat, {}, { source: params.get('source') || undefined, sink: params.get('sink') || undefined });

    // ── catalog: each section filters and sorts its own grid (`?sort=` / `?sink_sort=`) ──
    const SECTIONS = {
      sources: { kind: 'source', list: sources, grid: 'source-grid', param: 'sort', noun: 'source templates',
        none: '<div class="empty">No source templates yet — be the first to publish one.</div>' },
      sinks: { kind: 'sink', list: sinks, grid: 'sink-grid', param: 'sink_sort', noun: 'sink templates',
        none: '<div class="empty">No sink templates yet.</div>' },
    };
    // Owner and type facets: multi-select, combined with the text filter (AND
    // across facets, OR within one). Their state lives in the URL so a view can be shared.
    const FACETS = {
      owner: { label: 'Owner', of: (kind, t) => H.ownerKey(t),
        show: (v) => (v === H.OFFICIAL_OWNER ? `official · ${v}` : v ? '@' + v : 'unscoped'),
        order: (a, b, n) => (b === H.OFFICIAL_OWNER) - (a === H.OFFICIAL_OWNER) || n[b] - n[a] || H.natural(a, b) },
      type: { label: 'Type', of: (kind, t) => H.typeOf(kind, t), show: (v) => v || '—',
        order: (a, b, n) => n[b] - n[a] || H.natural(a, b) },
    };
    const CARDS_SHOWN = 12;
    const expanded = { sources: false, sinks: false };
    const PARAM = { sources: { owner: 'owner', type: 'type' }, sinks: { owner: 'sink_owner', type: 'sink_type' } };
    const selected = { sources: { owner: new Set(), type: new Set() }, sinks: { owner: new Set(), type: new Set() } };
    for (const key of Object.keys(selected)) {
      for (const f of Object.keys(FACETS)) {
        (params.get(PARAM[key][f]) || '').split(',').filter(Boolean).forEach((v) => selected[key][f].add(v));
      }
    }

    function syncUrl(key) {
      const u = new URL(location.href);
      for (const f of Object.keys(FACETS)) {
        const v = [...selected[key][f]].join(',');
        if (v) u.searchParams.set(PARAM[key][f], v); else u.searchParams.delete(PARAM[key][f]);
      }
      history.replaceState(null, '', u);
    }

    function renderFacets(key) {
      const sec = SECTIONS[key];
      const root = $('facets-' + key);
      root.innerHTML = Object.entries(FACETS).map(([f, def]) => {
        const counts = {};
        sec.list.forEach((t) => { const v = def.of(sec.kind, t); counts[v] = (counts[v] || 0) + 1; });
        const values = Object.keys(counts).sort((a, b) => def.order(a, b, counts));
        const sel = selected[key][f];
        const n = sel.size;
        return `<div class="facet" data-facet="${f}">
          <button type="button" class="facet-btn${n ? ' is-active' : ''}" aria-haspopup="true" aria-expanded="false">${def.label}${n ? `<span class="facet-n">${n}</span>` : ''}</button>
          <div class="facet-pop" role="group" aria-label="Filter ${sec.noun} by ${def.label.toLowerCase()}" hidden>
            ${values.length > 10 ? `<input class="filter facet-q" type="search" placeholder="find ${f === 'owner' ? 'an owner' : 'a type'}…" aria-label="Find ${f === 'owner' ? 'an owner' : 'a type'}" />` : ''}
            <div class="facet-opts">${values.map((v) => `<label class="facet-opt" data-v="${H.esc(v.toLowerCase())}"><input type="checkbox" value="${H.esc(v)}"${sel.has(v) ? ' checked' : ''} /><span class="facet-name">${H.esc(def.show(v))}</span><span class="facet-count">${counts[v]}</span></label>`).join('')}</div>
            <div class="facet-foot"><button type="button" class="linkish facet-clear"${n ? '' : ' disabled'}>Clear</button></div>
          </div>
        </div>`;
      }).join('');
    }

    function renderActive(key) {
      const box = $('active-' + key);
      const chips = [];
      for (const [f, def] of Object.entries(FACETS)) {
        for (const v of selected[key][f]) chips.push(`<button type="button" class="active-chip" data-facet="${f}" data-v="${H.esc(v)}" aria-label="Remove ${def.label.toLowerCase()} filter ${H.esc(def.show(v))}"><span class="dim">${def.label.toLowerCase()}:</span> ${H.esc(def.show(v))} <span aria-hidden="true">×</span></button>`);
      }
      box.innerHTML = chips.length ? chips.join('') + '<button type="button" class="linkish clear-all">Clear all</button>' : '';
      box.hidden = !chips.length;
    }

    const applyFilter = (key) => {
      const sec = SECTIONS[key];
      const raw = $('q-' + key).value.trim();
      const q = raw.toLowerCase();
      const { owner, type } = selected[key];
      const grid = $(sec.grid);
      let shown = 0;
      grid.querySelectorAll('.card').forEach((c) => {
        const ok = (!q || c.dataset.search.includes(q)) && (!owner.size || owner.has(c.dataset.owner)) && (!type.size || type.has(c.dataset.type));
        c.hidden = !ok;
        if (ok) shown++;
      });
      // Unfiltered, a section shows its first CARDS_SHOWN cards; any filter searches them all.
      const filtering = q || owner.size || type.size;
      const more = $('more-' + key);
      if (!filtering && !expanded[key] && shown > CARDS_SHOWN) {
        let i = 0;
        grid.querySelectorAll('.card:not([hidden])').forEach((c) => { if (++i > CARDS_SHOWN) c.hidden = true; });
      }
      if (!filtering && shown > CARDS_SHOWN) {
        more.hidden = false;
        more.firstElementChild.textContent = expanded[key] ? 'Show fewer' : `Show all ${shown} ${sec.noun}`;
      } else {
        more.hidden = true;
      }
      let miss = grid.querySelector('.no-match');
      if (filtering && !shown && sec.list.length) {
        if (!miss) { miss = document.createElement('div'); miss.className = 'empty no-match'; grid.append(miss); }
        miss.textContent = `No ${sec.noun} match these filters.`;
        miss.hidden = false;
      } else if (miss) {
        miss.hidden = true;
      }
    };
    const renderGrid = (key) => {
      const sec = SECTIONS[key];
      const cmp = H.SORTS[$('sort-' + key).value] || H.SORTS.rank;
      $(sec.grid).innerHTML = sec.list.length ? [...sec.list].sort(cmp).map((t) => H.card(sec.kind, t)).join('') : sec.none;
      applyFilter(key);
    };
    const facetChanged = (key) => { renderFacetButtons(key); renderActive(key); applyFilter(key); syncUrl(key); };
    // Update just the buttons' counts so an open popover keeps its focus and scroll.
    function renderFacetButtons(key) {
      for (const [f, def] of Object.entries(FACETS)) {
        const btn = $('facets-' + key).querySelector(`[data-facet="${f}"] .facet-btn`);
        const n = selected[key][f].size;
        btn.classList.toggle('is-active', !!n);
        btn.innerHTML = `${def.label}${n ? `<span class="facet-n">${n}</span>` : ''}`;
        const clear = btn.parentElement.querySelector('.facet-clear');
        if (clear) clear.disabled = !n;
      }
    }
    const closeAll = (except) => document.querySelectorAll('.hub-page .facet-pop:not([hidden])').forEach((pop) => {
      if (pop === except) return;
      pop.hidden = true;
      pop.previousElementSibling.setAttribute('aria-expanded', 'false');
    });

    for (const [key, sec] of Object.entries(SECTIONS)) {
      const wanted = params.get(sec.param);
      if (wanted && H.SORTS[wanted]) $('sort-' + key).value = wanted;
      renderFacets(key);
      renderActive(key);
      renderGrid(key);
      $('q-' + key).oninput = () => applyFilter(key);
      $('sort-' + key).onchange = () => {
        const u = new URL(location.href);
        const v = $('sort-' + key).value;
        if (v === 'rank') u.searchParams.delete(sec.param); else u.searchParams.set(sec.param, v);
        history.replaceState(null, '', u);
        renderGrid(key);
      };
      const facets = $('facets-' + key);
      facets.addEventListener('click', (e) => {
        const btn = e.target.closest('.facet-btn');
        if (btn) {
          const pop = btn.nextElementSibling;
          const open = pop.hidden;
          closeAll(pop);
          pop.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
          if (open) {
            // Open towards whichever side has room, so the list never runs off-screen.
            pop.classList.remove('is-right');
            if (pop.getBoundingClientRect().right > document.documentElement.clientWidth - 12) pop.classList.add('is-right');
          }
          if (open) (pop.querySelector('.facet-q') || pop.querySelector('input'))?.focus();
          return;
        }
        const clear = e.target.closest('.facet-clear');
        if (clear) {
          const f = clear.closest('.facet').dataset.facet;
          selected[key][f].clear();
          clear.closest('.facet').querySelectorAll('input[type=checkbox]').forEach((c) => { c.checked = false; });
          facetChanged(key);
        }
      });
      facets.addEventListener('change', (e) => {
        if (e.target.type !== 'checkbox') return;
        const f = e.target.closest('.facet').dataset.facet;
        if (e.target.checked) selected[key][f].add(e.target.value); else selected[key][f].delete(e.target.value);
        facetChanged(key);
      });
      facets.addEventListener('input', (e) => {
        if (!e.target.classList.contains('facet-q')) return;
        const q = e.target.value.trim().toLowerCase();
        e.target.closest('.facet-pop').querySelectorAll('.facet-opt').forEach((o) => { o.hidden = q && !o.dataset.v.includes(q); });
      });
      $('more-' + key).addEventListener('click', () => {
        expanded[key] = !expanded[key];
        applyFilter(key);
        if (!expanded[key]) $(key).scrollIntoView({ block: 'start' });
      });
      $('active-' + key).addEventListener('click', (e) => {
        const chip = e.target.closest('.active-chip');
        if (chip) selected[key][chip.dataset.facet].delete(chip.dataset.v);
        else if (e.target.closest('.clear-all')) Object.values(selected[key]).forEach((set) => set.clear());
        else return;
        renderFacets(key);
        facetChanged(key);
      });
    }
    document.addEventListener('click', (e) => { if (!e.target.closest('.hub-page .facet')) closeAll(); });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = document.querySelector('.hub-page .facet-pop:not([hidden])');
      if (open) { closeAll(); open.previousElementSibling.focus(); }
    });
    $('source-grid').setAttribute('aria-busy', 'false');
  })();
</script>
