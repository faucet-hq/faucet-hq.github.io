---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';

const D = 'https://faucet-hq.github.io/faucet-stream/cookbook';

const guards = [
  {
    name: 'PII masking',
    desc: 'Redact, hash, tokenize or partially mask sensitive fields, matched by name, pattern or value detector. Runs first, before quality, contract, drift, the sink, the DLQ and lineage, so a masked field never leaves unmasked. Keyed hashing (HMAC-SHA256) stays deterministic and joinable.',
    doc: `${D}/masking.html`,
    code: `masking:
  key: \${env:MASKING_KEY}      # keyed HMAC-SHA256
  rules:
    - name: emails
      match: { fields: [email] }
      action: { type: hash }
    - name: ssn
      match: { fields: [ssn] }
      action: { type: redact }`,
  },
  {
    name: 'Data-quality checks',
    desc: 'Assert invariants on every page, per record or per batch: not-null, regex, ranges, sets, uniqueness, row counts, JSON Schema. Failures abort the run or quarantine to a dead-letter queue.',
    doc: `${D}/quality.html`,
    code: `quality:
  record:
    - type: not_null
      field: email
      on_failure: abort
    - type: compare
      field: amount
      op: gte
      value: 0
      on_failure: quarantine`,
  },
  {
    name: 'Data contracts',
    desc: 'A versioned promise about the output shape (types, nullability, enums, patterns, bounds) enforced before the sink. Export it as JSON Schema or OpenLineage with faucet contract.',
    doc: `${D}/contracts.html`,
    code: `contract:
  version: "1"
  on_breach: quarantine
  fields:
    - { name: id, type: integer }
    - { name: status, type: string,
        enum: [active, churned] }`,
  },
  {
    name: 'Schema-drift policy',
    desc: 'Detect when the source shape changes and decide what happens (warn, evolve, ignore, quarantine or fail) instead of silently corrupting downstream.',
    doc: `${D}/schema-drift.html`,
    code: `schema:
  on_drift: quarantine
  # warn | evolve | ignore
  #   | quarantine | fail`,
  },
  {
    name: 'Data-flow policies',
    desc: 'Classify columns and declare which sinks each label may reach, such as PII only to EU sinks. validate, plan and doctor report violations before any data moves, and run refuses them.',
    doc: `${D}/policies.html`,
    code: `policy:
  version: 1
  classifications:
    - label: pii
      fields: [email, phone]
  rules:
    - name: pii-stays-in-eu
      when: { label: pii }
      require: { residency: [eu] }`,
  },
  {
    name: 'Column-level lineage',
    desc: 'Emit OpenLineage events with dataset schemas and column-level lineage derived from the transform chain, to Marquez or any OpenLineage endpoint, plus a movement catalog.',
    doc: `${D}/lineage.html`,
    code: `lineage:
  namespace: prod.warehouse
  include_schema_facet: true
  include_column_lineage: true
  transport:
    type: http
    config:
      url: \${env:MARQUEZ_URL}`,
  },
  {
    name: 'Change impact analysis',
    desc: 'Before a change ships, faucet plan --impact walks the catalog lineage graph and lists the datasets, contracts, owners and consumers a dropped or retyped column would break, with a severity for each.',
    doc: `${D}/impact.html`,
    code: `catalog:
  url: sqlite:./faucet-catalog.db

# then, before merging a change:
#   faucet plan orders.yaml --impact`,
  },
  {
    name: 'Freshness & volume SLAs',
    desc: 'Declare what healthy looks like: max staleness, minimum rows, or a learned volume baseline (±3σ). Violations emit a Prometheus counter you can alert on.',
    doc: `${D}/sla.html`,
    code: `sla:
  max_staleness_secs: 86400
  min_rows_per_run: 1
  volume_anomaly:
    method: zscore
    sensitivity: 3.0`,
  },
  {
    name: 'Column profiling',
    desc: 'Learn a per-column profile (null rate, type mix, distinct counts, distributions) every run and report statistically significant drift, with no thresholds to write.',
    doc: `${D}/profiling.html`,
    code: `profiling:
  min_history: 5     # runs before detection starts
  window: 20         # rolling baseline
  on_drift: warn     # warn | notify | fail`,
  },
  {
    name: 'Plan → approve → run',
    desc: 'Make runs and template changes wait for named approvers. faucet re-plans before it executes, refuses a change whose plan moved underneath it, and audits every step.',
    doc: `${D}/approvals.html`,
    code: `# auth.yaml (faucet serve --auth-config)
approvals:
  rules:
    - kinds: [run]
      roles: [operator, admin]
      min_approvers: 1
      self_approve: false

# faucet serve --auth-config auth.yaml \\
#   --require-approval run`,
  },
];
---

<Base
  title="Governance — faucet-stream"
  description="Governance in the movement path: PII masking before any sink, data-quality checks, versioned contracts, schema-drift policy, data-flow policies, column lineage, change impact analysis, SLAs, column profiling and change approvals — native and zero-config."
>
  <Header />
  <main id="main">
    <section class="section head">
      <div class="wrap">
        <span class="eyebrow" data-reveal>Governance in flight</span>
        <h1 data-reveal style="--reveal-delay:.05s">The guardrails live <span class="accent">in the pipe</span>.</h1>
        <p class="lede" data-reveal style="--reveal-delay:.1s">
          Everything that usually needs a second platform runs inside the movement path,
          with zero per-connector code — and a masked field never reaches the sink in the
          clear. Each guardrail is a config block; the engine applies them in order,
          per page, before every write.
        </p>

        <div class="gate" data-reveal aria-hidden="true">
          <span class="gate-node">source</span>
          <span class="gate-line"><i></i><i></i><i></i></span>
          <span class="gate-core">mask → quality → contract → drift</span>
          <span class="gate-line"><i></i><i></i><i></i></span>
          <span class="gate-node">sink</span>
        </div>
      </div>
    </section>

    <section class="wrap gov-wrap">
      {guards.map((g, i) => (
        <article class="gcard" data-reveal style={`--reveal-delay:${(i % 2) * 0.06}s`}>
          <div class="gcard-copy">
            <h2>{g.name}</h2>
            <p>{g.desc}</p>
            <a class="glink" href={g.doc}>Docs →</a>
          </div>
          <pre class="gcard-code"><code>{g.code}</code></pre>
        </article>
      ))}
    </section>

    <section class="wrap gov-note" data-reveal>
      <p>
        All of it is opt-in config on the same pipeline — no extra services, no
        downstream bolt-ons. See the <a href="https://faucet-hq.github.io/faucet-stream/">full guide</a>
        for every field and policy.
      </p>
    </section>

    <CTA />
  </main>
  <Footer />
</Base>

<style>
  .head { padding-bottom: 1rem; }
  .head h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); margin-top: 1rem; }
  .head h1 .accent { color: var(--teal-deep); }
  .lede { margin-top: 1.1rem; font-size: 1.1rem; color: var(--ink-soft); max-width: 46rem; }

  .gate {
    display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    margin-top: 2rem; flex-wrap: wrap;
  }
  .gate-node, .gate-core {
    font-family: var(--font-mono); font-size: 0.82rem; padding: 0.55rem 1rem;
    border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink-soft);
  }
  .gate-core { color: #fff; background: linear-gradient(90deg, var(--teal-deep), var(--teal)); border-color: transparent; font-weight: 600; box-shadow: var(--shadow-teal); }
  .gate-line { display: inline-flex; gap: 0.35rem; }
  .gate-line i { width: 6px; height: 6px; border-radius: 50%; background: var(--teal); opacity: 0.35; animation: gate-move 1.5s ease-in-out infinite; }
  .gate-line i:nth-child(2) { animation-delay: 0.2s; }
  .gate-line i:nth-child(3) { animation-delay: 0.4s; }
  @keyframes gate-move { 0%,100% { opacity: 0.25; transform: translateX(-2px); } 50% { opacity: 1; transform: translateX(2px); } }

  .gov-wrap {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem;
    margin-top: 1rem;
  }
  .gcard {
    display: grid; grid-template-rows: auto 1fr; gap: 1rem;
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface);
    padding: 1.5rem; transition: border-color 0.18s ease, box-shadow 0.2s ease;
  }
  .gcard:hover { border-color: color-mix(in srgb, var(--teal) 40%, var(--line)); box-shadow: var(--shadow-md); }
  .gcard h2 { font-size: 1.2rem; }
  .gcard-copy p { margin-top: 0.6rem; color: var(--ink-soft); font-size: 0.95rem; }
  .glink { display: inline-block; margin-top: 0.8rem; color: var(--teal-deep); font-weight: 550; font-size: 0.9rem; border-bottom: 1px solid color-mix(in srgb, var(--teal-deep) 35%, transparent); }
  .gcard-code {
    margin: 0; background: #0b1220; border: 1px solid #1c2740; border-radius: var(--radius-sm);
    padding: 1rem 1.1rem; overflow-x: auto; align-self: end;
  }
  .gcard-code code { font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.6; color: #cdd9ee; white-space: pre; }

  .gov-note { padding-top: 2rem; }
  .gov-note p { border-top: 1px solid var(--line); padding-top: 1.4rem; color: var(--ink-soft); font-size: 0.95rem; }
  .gov-note a { color: var(--teal-deep); border-bottom: 1px solid color-mix(in srgb, var(--teal-deep) 35%, transparent); }

  @media (prefers-reduced-motion: reduce) { .gate-line i { animation: none; opacity: 0.6; } }
  @media (max-width: 760px) {
    .gov-wrap { grid-template-columns: 1fr; }
    .gate-core { font-size: 0.72rem; }
  }
  /* Mobile: stack the gate vertically — nodes centered, connector dots vertical. */
  @media (max-width: 560px) {
    .gate { flex-direction: column; gap: 0.55rem; }
    .gate-line { flex-direction: column; gap: 0.4rem; }
    .gate-line i { animation-name: gate-move-v; }
    .gate-node, .gate-core { text-align: center; }
  }
  @keyframes gate-move-v {
    0%, 100% { opacity: 0.25; transform: translateY(-2px); }
    50% { opacity: 1; transform: translateY(2px); }
  }
</style>
