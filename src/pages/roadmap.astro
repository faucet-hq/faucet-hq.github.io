---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';

const EPIC = 'https://github.com/faucet-hq/faucet-stream/issues/38';
const BOARD = 'https://github.com/orgs/faucet-hq/projects/2';
const ISSUE = (n: number) => `https://github.com/faucet-hq/faucet-stream/issues/${n}`;

// Curated view of the direction. The live, authoritative tracker is the GitHub
// epic (#38) — this page links to it rather than duplicating every issue.
const horizons = [
  {
    tag: 'Now',
    heading: 'What we’re building',
    blurb:
      'Finish the last production-reliability fixes, and broaden SaaS coverage through maintained templates on the REST and GraphQL engines instead of a native crate per API.',
    themes: [
      {
        title: 'Production reliability',
        body: 'Status, lag, state tooling, versioned state and safe partial batches have shipped. What remains is making every file sink replace its output exactly as configured.',
        issues: [753, 752],
      },
      {
        title: 'SaaS via Template Hub',
        body: 'A maintained starter set of SaaS source templates (Salesforce, HubSpot, Stripe and more), backed by the REST and GraphQL engine work those APIs need.',
        issues: [724, 751, 747, 756, 755],
      },
      {
        title: 'REST engine correctness',
        body: 'Relative next-page links, replication binds on paginated URLs, nested replication keys and CSV null handling.',
        issues: [750, 749, 748, 754, 746],
      },
    ],
  },
  {
    tag: 'Next',
    heading: 'On deck',
    blurb:
      'Activate warehouse data back into operational tools, and make faucet easier to find and install.',
    themes: [
      {
        title: 'Reverse ETL',
        body: 'Salesforce, HubSpot and Google Sheets sinks with bulk upsert, rate limits, per-record failures and DLQ.',
        issues: [723],
      },
      {
        title: 'Connector Hub',
        body: 'An auto-generated, crates.io-backed catalog of first- and third-party connectors with conformance badges.',
        issues: [572],
      },
      {
        title: 'Windows',
        body: 'Prebuilt Windows binaries and a PowerShell installer are built; they ship with the next CLI release.',
        issues: [565],
      },
    ],
  },
  {
    tag: 'Exploring',
    heading: 'Further out',
    blurb:
      'Pulled forward on concrete demand rather than built speculatively.',
    themes: [
      {
        title: 'More connectors',
        body: 'Cassandra / ScyllaDB, Cosmos DB, Firestore and Bigtable, MQTT, Pulsar and Azure Service Bus, and vector stores.',
        issues: [714, 715, 716, 717, 718, 721],
      },
      {
        title: 'Unstructured to structured',
        body: 'Document extraction, chunking and embeddings as in-flight transforms.',
        issues: [705],
      },
      {
        title: 'Adoption & DX',
        body: 'Docs, positioning, examples, community, and the technical white-paper program.',
        issues: [91, 583, 314],
      },
    ],
  },
];
---

<Base
  title="Roadmap — faucet-stream"
  description="Where faucet-stream is headed: production reliability, SaaS coverage through the Template Hub, reverse ETL, and the connector ecosystem — tracked live on the GitHub roadmap board."
>
  <Header />
  <main id="main">
    <section class="section head">
      <div class="wrap">
        <span class="eyebrow" data-reveal>Roadmap</span>
        <h1 data-reveal style="--reveal-delay:.05s">Where faucet-stream is headed</h1>
        <p class="lede" data-reveal style="--reveal-delay:.1s">
          The runtime, CLI, governance layer and replication story are in place. The work
          now is finishing production reliability, broadening SaaS coverage without a crate
          per API, and growing the ecosystem around the engine. This is the curated view; the live tracker
          is the <a href={BOARD}>roadmap board on GitHub</a>, where every issue is public
          and open to comment.
        </p>
        <a class="epic-link" href={BOARD} data-reveal style="--reveal-delay:.15s">
          Track it live on the GitHub roadmap board →
        </a>
      </div>
    </section>

    <section class="wrap shipped" data-reveal>
      <h2>The foundation, shipped</h2>
      <p>
        Exactly-once and effectively-once delivery, unified write modes / upsert, CDC with
        crash-safe bookmarks, and a full in-flight governance layer: quality, contracts,
        schema-drift, PII masking, data-flow policies, change impact analysis, column
        profiling and SLAs. The <code>faucet serve</code> control plane adds triggers,
        clustering, RBAC, plan → approve → run, budgets and cost accounting, multi-tenant
        embedding, a web console and a data-movement catalog.
      </p>
      <p>
        Recently landed: Oracle, DynamoDB, the Iceberg source and the Databricks sink,
        multi-table <code>faucet mirror</code>, <code>faucet status</code> and state
        tooling, versioned state, safe partial batches, local file connectors with Avro and
        ORC, and the Singer target bridge. The fleet ships <b>43 sources and 35 sinks</b>.
      </p>
    </section>

    {horizons.map((h) => (
      <section class="wrap horizon">
        <div class="horizon-head" data-reveal>
          <span class={`htag htag--${h.tag.toLowerCase()}`}>{h.tag}</span>
          <h2>{h.heading}</h2>
          <p>{h.blurb}</p>
        </div>
        <div class="theme-grid">
          {h.themes.map((t) => (
            <article class="theme" data-reveal>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
              <div class="issues">
                {t.issues.map((n) => (
                  <a class="issue" href={ISSUE(n)}>#{n}</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="wrap note" data-reveal>
      <p>
        Priorities shift as the work and the community do. For the authoritative,
        always-current picture — and to weigh in — follow
        <a href={BOARD}>the roadmap board</a>, <a href={EPIC}>the roadmap epic</a> and the
        <a href="https://github.com/faucet-hq/faucet-stream/issues">open issues</a> on GitHub.
      </p>
    </section>

    <CTA />
  </main>
  <Footer />
</Base>

<style>
  .head { padding-bottom: 0.5rem; }
  .head h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); margin-top: 1rem; }
  .lede { margin-top: 1.1rem; font-size: 1.1rem; color: var(--ink-soft); max-width: 46rem; line-height: 1.6; }
  .lede a { color: var(--teal-deep); border-bottom: 1px solid color-mix(in srgb, var(--teal-deep) 35%, transparent); }
  .epic-link { display: inline-block; margin-top: 1.4rem; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600; color: var(--teal-deep); border: 1px solid color-mix(in srgb, var(--teal) 45%, transparent); background: color-mix(in srgb, var(--teal) 10%, transparent); border-radius: 999px; padding: 0.55rem 1rem; transition: background 0.15s ease, border-color 0.15s ease; }
  .epic-link:hover { background: color-mix(in srgb, var(--teal) 18%, transparent); border-color: color-mix(in srgb, var(--teal) 60%, transparent); }

  .shipped { margin-top: 2.4rem; border: 1px solid var(--line); border-radius: var(--radius); background: color-mix(in srgb, var(--teal) 5%, var(--surface)); padding: 1.6rem 1.8rem; }
  .shipped h2 { font-size: 1.15rem; }
  .shipped p { margin-top: 0.6rem; color: var(--ink-soft); line-height: 1.7; }
  .shipped b { color: var(--ink); }
  .shipped code { font-family: var(--font-mono); font-size: 0.85em; color: var(--teal-deep); }

  .horizon { margin-top: 3rem; }
  .horizon-head h2 { font-size: 1.5rem; margin-top: 0.4rem; }
  .horizon-head p { margin-top: 0.6rem; color: var(--ink-soft); max-width: 46rem; line-height: 1.65; }
  .htag { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; padding: 0.25rem 0.7rem; border-radius: 999px; }
  .htag--now { color: var(--teal-deep); background: color-mix(in srgb, var(--teal) 14%, transparent); }
  .htag--next { color: var(--ink-soft); background: color-mix(in srgb, var(--ink-faint) 12%, transparent); }
  .htag--exploring { color: var(--ink-faint); background: color-mix(in srgb, var(--ink-faint) 8%, transparent); border: 1px solid var(--line); }

  .theme-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; margin-top: 1.3rem; }
  .theme { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 1.4rem; display: flex; flex-direction: column; transition: border-color 0.18s ease, box-shadow 0.2s ease, transform 0.18s ease; }
  .theme:hover { border-color: color-mix(in srgb, var(--teal) 40%, var(--line)); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .theme h3 { font-size: 1.05rem; line-height: 1.3; }
  .theme p { margin-top: 0.5rem; color: var(--ink-soft); font-size: 0.92rem; line-height: 1.6; flex: 1; }
  .issues { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; }
  .issue { font-family: var(--font-mono); font-size: 0.72rem; color: var(--teal-deep); background: color-mix(in srgb, var(--teal) 10%, transparent); border-radius: 999px; padding: 0.24rem 0.55rem; transition: background 0.15s ease; }
  .issue:hover { background: color-mix(in srgb, var(--teal) 20%, transparent); }

  .note { margin-top: 3rem; }
  .note p { color: var(--ink-soft); line-height: 1.7; max-width: 46rem; }
  .note a { color: var(--teal-deep); border-bottom: 1px solid color-mix(in srgb, var(--teal-deep) 35%, transparent); }

  @media (max-width: 860px) { .theme-grid { grid-template-columns: 1fr; } }
</style>
