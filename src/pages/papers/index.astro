---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';

const base = import.meta.env.BASE_URL;

const papers = [
  {
    title: 'Governance in the Movement Path',
    blurb:
      'Masking, quality, contracts, schema-drift policy, column lineage, and SLAs enforced inside the pipe — per page, before any write — with a mask-first ordering guarantee proven in CI.',
    href: `${base}papers/governance-in-the-movement-path`,
    status: 'Published',
    tags: ['Governance', 'Security', 'Lineage', 'Quality'],
  },
  {
    title: 'A Zero-Cost Columnar Fast Path',
    blurb:
      'How faucet-stream runs Arrow end-to-end when both ends support it — negotiated as a pure escape hatch, with default builds byte-identical to the row path.',
    href: `${base}papers/columnar-fast-path`,
    status: 'Published',
    tags: ['Performance', 'Columnar', 'Arrow'],
  },
  {
    title: 'Crash-Safe Change Data Capture',
    blurb:
      'Advancing the replication checkpoint only from a durable bookmark — never from decoded WAL or a keepalive — so no committed change is lost on crash. Postgres, MySQL, MongoDB, SQL Server.',
    href: `${base}papers/crash-safe-cdc`,
    status: 'Published',
    tags: ['Reliability', 'CDC', 'Delivery guarantees'],
  },
  {
    title: 'Benchmarks & Methodology',
    blurb:
      'The reproducible 1M-row reference move: 712k rows/s, ~96× Meltano, single binary — the method, the caveats, and why streaming Rust wins.',
    status: 'Planned',
    tags: ['Performance', 'Benchmarks', 'Throughput'],
  },
];

// Status facet: canonical order, always rendered (even empty buckets).
const STATUSES = ['Published', 'Draft', 'Planned'];

// Topic facet: every tag, most-used first, then alphabetical.
const counts = new Map<string, number>();
for (const p of papers) for (const t of p.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const allTags = [...counts.keys()].sort(
  (a, b) => (counts.get(b)! - counts.get(a)!) || a.localeCompare(b),
);
---

<Base
  title="Papers — faucet-stream"
  description="Technical white papers on faucet-stream: in-flight governance, the zero-cost columnar fast path, crash-safe CDC, and benchmark methodology."
>
  <Header />
  <main id="main">
    <section class="section head">
      <div class="wrap">
        <span class="eyebrow" data-reveal>Papers</span>
        <h1 data-reveal style="--reveal-delay:.05s">Technical white papers</h1>
        <p class="lede" data-reveal style="--reveal-delay:.1s">
          Deep dives on the parts of faucet-stream that are a genuine engineering
          contribution — each grounded in the real implementation, with every claim
          verified against the code before it ships.
        </p>
      </div>
    </section>

    <section class="wrap filterbar" aria-label="Filter papers">
      <div class="filter-group">
        <span class="filter-label">Status</span>
        <div class="filter-tags">
          {STATUSES.map((s) => (
            <button type="button" class="filter-pill" data-status={s} aria-pressed="false">{s}</button>
          ))}
        </div>
      </div>
      <div class="filter-group">
        <span class="filter-label">Topic</span>
        <div class="filter-tags">
          {allTags.map((t) => (
            <button type="button" class="filter-pill" data-tag={t} aria-pressed="false">{t}</button>
          ))}
        </div>
      </div>
      <div class="filter-meta">
        <span id="filter-count"></span>
        <button type="button" id="filter-clear" hidden>Clear filters</button>
      </div>
    </section>

    <section class="wrap papers-grid" id="papers">
      {papers.map((p) => (
        <article
          class={`pcard ${p.href ? '' : 'pcard--soon'}`}
          data-status={p.status}
          data-tags={p.tags.join('|')}
        >
          <div class="pcard-top">
            <span class={`pstatus is-${p.status.toLowerCase()}`}>{p.status}</span>
          </div>
          <h2>{p.title}</h2>
          <p>{p.blurb}</p>
          <div class="card-tags">
            {p.tags.map((t) => <span class="tag-pill">{t}</span>)}
          </div>
          {p.href
            ? <a class="pread" href={p.href}>Read the paper →</a>
            : <span class="psoon">Coming soon</span>}
        </article>
      ))}
    </section>
    <p class="wrap empty" id="empty" hidden>
      No papers match those filters. <button type="button" id="empty-clear">Clear filters</button>
    </p>

    <CTA />
  </main>
  <Footer />
</Base>

<script is:inline>
  (function () {
    const cards = Array.from(document.querySelectorAll('#papers .pcard'));
    const pills = Array.from(document.querySelectorAll('.filter-pill'));
    const countEl = document.getElementById('filter-count');
    const clearBtn = document.getElementById('filter-clear');
    const emptyClear = document.getElementById('empty-clear');
    const emptyEl = document.getElementById('empty');
    const activeStatus = new Set();
    const activeTags = new Set();

    function render() {
      let shown = 0;
      for (const c of cards) {
        const status = c.dataset.status;
        const tags = (c.dataset.tags || '').split('|').filter(Boolean);
        const sMatch = activeStatus.size === 0 || activeStatus.has(status);
        const tMatch = activeTags.size === 0 || tags.some((t) => activeTags.has(t));
        const match = sMatch && tMatch;
        c.hidden = !match;
        if (match) shown++;
      }
      const filtering = activeStatus.size > 0 || activeTags.size > 0;
      countEl.textContent = filtering
        ? 'Showing ' + shown + ' of ' + cards.length + ' papers'
        : 'Showing all ' + cards.length + ' papers';
      clearBtn.hidden = !filtering;
      emptyEl.hidden = shown !== 0;
    }

    function paint(btn, on) {
      btn.setAttribute('aria-pressed', String(on));
      btn.classList.toggle('on', on);
    }

    function toggle(btn, force) {
      const isStatus = 'status' in btn.dataset;
      const set = isStatus ? activeStatus : activeTags;
      const key = isStatus ? btn.dataset.status : btn.dataset.tag;
      const on = force === undefined ? !set.has(key) : force;
      if (on) set.add(key);
      else set.delete(key);
      paint(btn, on);
    }

    function clearAll() {
      activeStatus.clear();
      activeTags.clear();
      pills.forEach((b) => paint(b, false));
      render();
    }

    pills.forEach((b) =>
      b.addEventListener('click', () => {
        toggle(b);
        render();
      }),
    );
    clearBtn.addEventListener('click', clearAll);
    emptyClear.addEventListener('click', clearAll);

    // Pre-activate from ?status=A,B and ?tags=C,D (e.g. a tag clicked on a paper page).
    const params = new URLSearchParams(location.search);
    const wantStatus = new Set((params.get('status') || '').split(',').map((s) => s.trim()).filter(Boolean));
    const wantTags = new Set((params.get('tags') || '').split(',').map((s) => s.trim()).filter(Boolean));
    pills.forEach((b) => {
      if ('status' in b.dataset && wantStatus.has(b.dataset.status)) toggle(b, true);
      if ('tag' in b.dataset && wantTags.has(b.dataset.tag)) toggle(b, true);
    });
    render();
  })();
</script>

<style>
  .head { padding-bottom: 1rem; }
  .head h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); margin-top: 1rem; }
  .lede { margin-top: 1.1rem; font-size: 1.1rem; color: var(--ink-soft); max-width: 44rem; }

  .filterbar { display: flex; flex-direction: column; gap: 0.85rem; margin-top: 0.6rem; }
  .filter-group { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.6rem 0.7rem; }
  .filter-label { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); min-width: 3.6rem; }
  .filter-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .filter-pill { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 550; letter-spacing: 0.01em; line-height: 1; color: var(--ink-faint); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 0.42rem 0.74rem; cursor: pointer; transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease; }
  .filter-pill:hover { color: var(--teal-deep); border-color: color-mix(in srgb, var(--teal) 40%, var(--line)); }
  .filter-pill.on { color: var(--teal-deep); background: color-mix(in srgb, var(--teal) 12%, transparent); border-color: color-mix(in srgb, var(--teal) 45%, transparent); }
  .filter-meta { display: flex; align-items: center; gap: 0.9rem; margin-top: 0.1rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-faint); }
  #filter-clear, #empty-clear { font-family: var(--font-mono); font-size: 0.78rem; color: var(--teal-deep); background: none; border: 0; padding: 0; cursor: pointer; border-bottom: 1px solid color-mix(in srgb, var(--teal-deep) 35%, transparent); }

  .papers-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-top: 1.1rem; }
  .pcard { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 1.6rem; display: flex; flex-direction: column; transition: border-color 0.18s ease, box-shadow 0.2s ease, transform 0.18s ease; }
  .pcard[hidden] { display: none; }
  .pcard:hover { border-color: color-mix(in srgb, var(--teal) 40%, var(--line)); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .pcard--soon { opacity: 0.72; }
  .pcard-top { display: flex; justify-content: flex-start; align-items: center; margin-bottom: 0.7rem; }
  .pstatus { font-family: var(--font-mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-faint); border: 1px solid var(--line); border-radius: 999px; padding: 0.2rem 0.6rem; }
  .pstatus.is-published { color: var(--teal-deep); border-color: color-mix(in srgb, var(--teal) 45%, transparent); background: color-mix(in srgb, var(--teal) 12%, transparent); }
  .pstatus.is-draft { color: var(--ink-soft); border-color: color-mix(in srgb, var(--ink-faint) 55%, var(--line)); background: color-mix(in srgb, var(--ink-faint) 8%, transparent); }
  .pstatus.is-planned { color: var(--ink-faint); border-color: var(--line); background: transparent; }
  .pcard h2 { font-size: 1.25rem; }
  .pcard p { margin-top: 0.5rem; color: var(--ink-soft); font-size: 0.95rem; line-height: 1.6; flex: 1; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; }
  .tag-pill { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.01em; line-height: 1; color: var(--teal-deep); background: color-mix(in srgb, var(--teal) 10%, transparent); border: 1px solid color-mix(in srgb, var(--teal) 24%, transparent); border-radius: 999px; padding: 0.3rem 0.6rem; }
  .pread { margin-top: 1rem; color: var(--teal-deep); font-weight: 600; font-size: 0.92rem; border-bottom: 1px solid color-mix(in srgb, var(--teal-deep) 35%, transparent); align-self: flex-start; }
  .psoon { margin-top: 1rem; color: var(--ink-faint); font-size: 0.88rem; font-family: var(--font-mono); }
  .empty { margin-top: 1.4rem; color: var(--ink-soft); }

  @media (max-width: 720px) { .papers-grid { grid-template-columns: 1fr; } }
</style>
